{
  "$schema": "https://renovatebot.com",
  "extends": [
    "config:recommended"
  ],
  "baseBranches": ["main"],
  "timezone": "America/Bogota",
  "dependencyDashboard": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies",
      "automerge": true
    },
    {
      "matchPackageNames": ["eslint"],
      "groupName": "eslint group"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": ["security"]
  }
}
